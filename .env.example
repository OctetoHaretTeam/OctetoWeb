# OctetoHaret — environment template.
# Copy to `.env` and fill in. Never commit `.env`.
#
# Anything prefixed VITE_ is inlined into the CLIENT BUNDLE and is public.
# Everything else is server-only. Do not add VITE_ to a secret (CLAUDE.md §9).

# ─── Database — Neon serverless Postgres ────────────────────────────────────
# Pooled connection string from the Neon dashboard. Used by the app at runtime
# and by drizzle-kit for migrations.
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/octetoharet?sslmode=require"

# ─── File storage — Vercel Blob ─────────────────────────────────────────────
# Images and portfolio PDFs. Postgres stores no files (CLAUDE.md §3).
# Vercel injects this automatically in deployed environments; needed locally.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# ─── Auth — Google sign-in, no user table (CLAUDE.md §9) ────────────────────
GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxxxxxxxxxx"

# OAuth callback. Must exactly match an Authorised redirect URI in the Google
# Cloud console. Add the production URL there too once the domain is locked.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# Comma-separated allowlist of admin emails, compared lowercased against the
# Google profile email. SERVER-SIDE ONLY — never VITE_ prefixed, never in the
# client bundle. An address not on this list gets a 403 and no record.
ALLOWED_ADMIN_EMAILS="cineva@example.com,altcineva@example.com"

# Secret used to sign the session cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="replace-me-with-32-random-bytes"

# Session lifetime, sliding window refreshed on activity (CLAUDE.md §9).
SESSION_MAX_AGE_HOURS="8"

# ─── Site ───────────────────────────────────────────────────────────────────
# Absolute origin, no trailing slash. Needed for hreflang alternates, canonical
# URLs and og: tags (CLAUDE.md §11). Public — safe to expose to the client.
# TODO: the final domain is still open (CLAUDE.md §15.2) and gets printed on
# merchandise, so lock it before any merch run.
VITE_SITE_URL="http://localhost:3000"
